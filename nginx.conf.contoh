# /etc/nginx/sites-available/absensi  (ganti absensi.sman1tumijajar.sch.id dengan domain Anda)
server {
    listen 80;
    server_name absensi.sman1tumijajar.sch.id;
    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
# Lalu aktifkan HTTPS (WAJIB agar kamera & GPS berfungsi di HP):
#   sudo certbot --nginx -d absensi.sman1tumijajar.sch.id
